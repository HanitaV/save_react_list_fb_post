{
  "manifest_version": 3,
  "name": "Facebook Engagement Inspector",
  "version": "0.2.0",
  "description": "One-click review of visible Facebook post reactions and accessible profile activity.",
  "permissions": ["activeTab", "scripting", "storage", "tabs", "alarms"],
  "host_permissions": ["https://www.facebook.com/*", "https://facebook.com/*", "https://m.facebook.com/*"],
  "action": { "default_title": "Quét reaction và wall", "default_popup": "popup.html" },
  "background": { "service_worker": "background.js" }
}
